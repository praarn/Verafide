# ---- Core --------------------------------------------------------------
# ENV=production makes startup log loud warnings about insecure defaults.
ENV=development
LOG_LEVEL=INFO

# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
# If unset, a random key is used per-process and every restart logs everyone out.
SECRET_KEY=change-me-to-a-long-random-string
# Short-lived access token; the refresh token is the long-lived, revocable one.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- Database ---------------------------------------------------------
# Postgres in Docker/prod. For local dev without a Postgres server, use SQLite:
#   DATABASE_URL=sqlite:///./app.db
DATABASE_URL=postgresql+psycopg://verafide:verafide@localhost:5432/verafide
# true = run create_all() on startup (dev). In Docker/CI set false and run
# `alembic upgrade head` from the entrypoint instead.
DB_CREATE_ALL=true

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Limits ---------------------------------------------------------
MAX_TEXT_CHARS=60000
MAX_IMAGE_MB=8
MAX_AUDIO_MB=25
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_HEAVY_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Groq (optional; enables LLM verdict + summarizer + chat + audio) ----
# Free key: https://console.groq.com/keys   Models: https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_MAX_CONTEXT_CHARS=28000

# ---- RAG ------------------------------------------------------------
RAG_ENABLED=true
RAG_TOP_K=4

# ---- OCR (optional; Windows usually needs the explicit path) --------
TESSERACT_CMD=
